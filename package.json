{
  "name": "synk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx server.ts --dev",
    "build": "prisma generate && next build",
    "start": "node --import tsx server.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@next-auth/prisma-adapter": "1.0.7",
    "@next/env": "16.4.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie": "1.0.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "6.19.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
