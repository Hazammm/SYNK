# Copy to .env. Never commit .env or real credentials.
DATABASE_URL="postgresql://synk:synk_local_only@127.0.0.1:5432/synk?schema=public"
# Disposable PostgreSQL database for integration and browser tests. Do not use production.
TEST_DATABASE_URL="postgresql://synk:synk_local_only@127.0.0.1:5432/synk_test?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
PORT=3000

# Mailtrap API delivery (preferred); set MAIL_FROM to a verified sender.
MAILTRAP_API_TOKEN=""
MAIL_FROM=""

# SMTP fallback when MAILTRAP_API_TOKEN is unset.
MAILTRAP_HOST=""
MAILTRAP_PORT=2525
MAILTRAP_USER=""
MAILTRAP_PASS=""

# Google OAuth — optional. See the Google OAuth section in README.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated exact addresses of the reverse proxies in front of Synk, so
# rate limits apply per client rather than to the proxy's address. X-Forwarded-For
# is ignored on connections from anywhere else. Leave unset without a proxy.
# TRUSTED_PROXY_IPS="10.0.0.5"

# AI agent (optional). The agent runs as a separate Python service: npm run agent:up
# AI_SERVICE_SECRET is shared by both services. Generate it with the same command as NEXTAUTH_SECRET.
# AI_SERVICE_URL="http://127.0.0.1:8000"
# AI_SERVICE_SECRET=""
# Model as "<provider>:<model>". The default uses Google AI Studio's free tier with GOOGLE_API_KEY.
# LLM_MODEL="google_genai:gemini-3.5-flash"
# GOOGLE_API_KEY=""
