# Copy to .env. Never commit .env or real credentials.
DATABASE_URL="postgresql://synk:synk_local_only@127.0.0.1:5432/synk?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
PORT=3000

# Workspace invitations, password resets, and welcome emails via Mailtrap
# (https://mailtrap.io). Required by `npm start`.
MAILTRAP_HOST=""
MAILTRAP_PORT=2525
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAIL_FROM=""

# Google OAuth — optional. See the Google OAuth section in README.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated exact addresses of the reverse proxies in front of Synk, so
# rate limits apply per client rather than to the proxy's address. X-Forwarded-For
# is ignored on connections from anywhere else. Leave unset without a proxy.
# TRUSTED_PROXY_IPS="10.0.0.5"
