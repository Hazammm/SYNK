# Copy to .env. Never commit .env or real credentials.
DATABASE_URL="postgresql://synk:synk_local_only@127.0.0.1:5432/synk?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
PORT=3000

# Workspace invitations via Mailtrap (https://mailtrap.io).
# Set these to enable email delivery for workspace invitations.
MAILTRAP_HOST=""
MAILTRAP_PORT=2525
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAIL_FROM=""

# Optional local demo seed. Set a password of at least 10 characters to run db:seed.
# SEED_DEMO_PASSWORD=""

# Password-reset email via Resend (https://resend.com). Required by `npm start`.
# If unset in development, reset links are printed to the server console.
# RESEND_API_KEY=""
# EMAIL_FROM="Synk <noreply@your-domain.com>"

# Comma-separated exact addresses of the reverse proxies in front of Synk, so
# rate limits apply per client rather than to the proxy's address. X-Forwarded-For
# is ignored on connections from anywhere else. Leave unset without a proxy.
# TRUSTED_PROXY_IPS="10.0.0.5"
