# Copy to .env. Never commit .env or real credentials.
DATABASE_URL="postgresql://synk:synk_local_only@localhost:5432/synk?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
PORT=3000

# Optional OAuth providers: each button appears only when BOTH values are set.
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/<google|github|bitbucket>
GOOGLE_ID=""
GOOGLE_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
BITBUCKET_ID=""
BITBUCKET_SECRET=""

# Optional local demo seed. Set a password of at least 10 characters to run db:seed.
# SEED_DEMO_PASSWORD=""
