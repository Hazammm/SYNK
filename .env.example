# Copy to .env. Never commit .env or real credentials.
DATABASE_URL="postgresql://synk:synk_local_only@127.0.0.1:5432/synk?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
PORT=3000

# Optional OAuth providers: each button appears only when BOTH values are set.
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/<google|github|bitbucket>
GOOGLE_ID=""
GOOGLE_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
BITBUCKET_ID=""
BITBUCKET_SECRET=""

# Optional local demo seed. Set a password of at least 10 characters to run db:seed.
# SEED_DEMO_PASSWORD=""

# Password-reset email via Resend (https://resend.com). Required by `npm start`.
# If unset in development, reset links are printed to the server console.
# RESEND_API_KEY=""
# EMAIL_FROM="Synk <noreply@your-domain.com>"

# Comma-separated exact addresses of the reverse proxies in front of Synk, so
# rate limits apply per client rather than to the proxy's address. X-Forwarded-For
# is ignored on connections from anywhere else. Leave unset without a proxy.
# TRUSTED_PROXY_IPS="10.0.0.5"

# AI agent (optional). The agent runs as a separate Python service: npm run agent:up
# AI_SERVICE_SECRET is shared by both services. Generate it with the same command as NEXTAUTH_SECRET.
# AI_SERVICE_URL="http://127.0.0.1:8000"
# AI_SERVICE_SECRET=""
# Model as "<provider>:<model>". The default uses Google AI Studio's free tier with GOOGLE_API_KEY.
# LLM_MODEL="google_genai:gemini-3.5-flash"
# GOOGLE_API_KEY=""
