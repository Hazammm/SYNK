generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum ProjectLevel {
  READ
  WRITE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id                    String               @id @default(cuid())
  name                  String?
  email                 String?              @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  notifyAssigned        Boolean              @default(true)
  notifyComments        Boolean              @default(true)
  notifyMentions        Boolean              @default(true)
  lastActiveWorkspaceId String?
  createdAt             DateTime             @default(now())
  accounts              Account[]
  sessions              Session[]
  loginSessions         LoginSession[]
  memberships           Membership[]
  messages              Message[]
  projectAccess         ProjectAccess[]
  createdChannels       Channel[]
  createdWorkspaces     Workspace[]          @relation("WorkspaceCreator")
  sentInvites           Invite[]             @relation("InviteSender")
  passwordResetTokens   PasswordResetToken[]
  lastActiveWorkspace   Workspace?           @relation("UserLastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id], onDelete: SetNull)
  assignedTickets       Ticket[]             @relation("TicketAssignee")
  reportedTickets       Ticket[]             @relation("TicketReporter")
  comments              Comment[]
  notifications         Notification[]       @relation("NotificationRecipient")
  sentNotifications     Notification[]       @relation("NotificationActor")
  conversations         Conversation[]
  actionLogs            ActionLog[]
  createdDocs           Doc[]                @relation("DocCreator")
  editedDocs            Doc[]                @relation("DocEditor")
  timeEntries           TimeEntry[]
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum PendingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_COMMENT
  TICKET_MENTION
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// JWT cookies remain NextAuth-managed. This record permits actual logout revocation.
model LoginSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-use, time-limited password reset tokens. Stored as SHA-256 hashes.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  createdById   String
  createdAt     DateTime       @default(now())
  createdBy     User           @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships   Membership[]
  channels      Channel[]
  projects      Project[]
  invites       Invite[]
  activeUsers   User[]         @relation("UserLastActiveWorkspace")
  conversations Conversation[]
  actionLogs    ActionLog[]
}

model Membership {
  workspaceId    String
  userId         String
  role           WorkspaceRole   @default(MEMBER)
  createdAt      DateTime        @default(now())
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelMembers ChannelMember[]

  @@id([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  status      InviteStatus  @default(PENDING)
  expiresAt   DateTime
  invitedById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([workspaceId])
}

model Channel {
  id          String          @id @default(cuid())
  workspaceId String
  createdById String
  creator     User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  name        String
  description String          @default("")
  isPrivate   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
}

model ChannelMember {
  channelId   String
  userId      String
  workspaceId String
  joinedAt    DateTime   @default(now())
  channel     Channel    @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership  Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([workspaceId, userId])
}

model Message {
  id              String    @id @default(cuid())
  channelId       String
  senderId        String
  body            String    @db.Text
  parentId        String?
  clientMessageId String
  createdAt       DateTime  @default(now())
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  parent          Message?  @relation("Thread", fields: [parentId, channelId], references: [id, channelId], onDelete: Cascade)
  replies         Message[] @relation("Thread")

  @@unique([id, channelId])
  @@unique([senderId, channelId, clientMessageId])
  @@index([channelId, parentId, createdAt, id])
}

// Issue tracking (PRD 6.4). A project owns boards, sprints and tickets.
// `key` is the ticket prefix (SYN in SYN-12) and is unique inside a workspace,
// so a ticket key identifies one ticket per workspace.
model Project {
  id               String          @id @default(cuid())
  workspaceId      String
  name             String
  key              String
  nextTicketNumber Int             @default(1)
  createdAt        DateTime        @default(now())
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  access           ProjectAccess[]
  boards           Board[]
  sprints          Sprint[]
  tickets          Ticket[]
  docs             Doc[]
  timeEntries      TimeEntry[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model ProjectAccess {
  projectId String
  userId    String
  level     ProjectLevel @default(READ)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Board {
  id        String        @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime      @default(now())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
  tickets   Ticket[]

  @@unique([id, projectId])
  @@index([projectId])
}

// A status column. `isDone` marks columns whose tickets count as completed.
model BoardColumn {
  id       String   @id @default(cuid())
  boardId  String
  name     String
  position Int
  isDone   Boolean  @default(false)
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@unique([id, boardId])
  @@index([boardId, position])
}

model Sprint {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  goal        String      @default("")
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  state       SprintState @default(PLANNED)
  completedAt DateTime?
  // Unfinished tickets returned to the backlog when the sprint was completed.
  carriedOver Int?
  createdAt   DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@unique([id, projectId])
  @@index([projectId, state])
}

// Composite foreign keys guarantee a ticket's board, column and sprint all
// belong to the ticket's own project. NoAction (checked at statement end)
// lets a project or board delete cascade through all of them together.
model Ticket {
  id            String         @id @default(cuid())
  projectId     String
  boardId       String
  columnId      String
  sprintId      String?
  key           String
  title         String
  description   String         @default("") @db.Text
  priority      TicketPriority @default(MEDIUM)
  assigneeId    String?
  reporterId    String?
  dueDate       DateTime?      @db.Date
  position      Int            @default(0)
  // Set while the ticket sits in a done column; sprint reports chart it.
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board         Board          @relation(fields: [boardId, projectId], references: [id, projectId], onDelete: Cascade)
  column        BoardColumn    @relation(fields: [columnId, boardId], references: [id, boardId], onDelete: NoAction)
  sprint        Sprint?        @relation(fields: [sprintId, projectId], references: [id, projectId], onDelete: NoAction)
  assignee      User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter      User?          @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments      Comment[]
  notifications Notification[]
  timeEntries   TimeEntry[]

  @@unique([projectId, key])
  @@index([boardId, columnId, position])
  @@index([projectId, sprintId])
  @@index([assigneeId])
}

model Comment {
  id            String         @id @default(cuid())
  ticketId      String
  authorId      String
  body          String         @db.Text
  createdAt     DateTime       @default(now())
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([ticketId, createdAt])
}

// In-app notification (PRD 6.9). `readAt` is null while unread.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  ticketId    String
  commentId   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  ticket      Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

// AI agent (PRD 6.6). A conversation is private to one person in one workspace.
// The agent service keeps the model's working memory; these rows are the readable transcript.
model Conversation {
  id          String                @id @default(cuid())
  userId      String
  workspaceId String
  title       String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]

  @@index([userId, workspaceId, updatedAt])
}

// `actions` lists the tool calls made for this reply. `pending` describes a change
// that waits for the person's confirmation, and `pendingStatus` records their answer.
model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ConversationRole
  body           String           @db.Text
  actions        Json             @default("[]")
  pending        Json?
  pendingStatus  PendingStatus?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Audit trail of every tool the agent ran or tried to run, including denials and previews.
model ActionLog {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String
  conversationId String?
  tool           String
  dryRun         Boolean   @default(false)
  ok             Boolean
  target         String?
  parameters     Json
  result         Json
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

// Docs (PRD 6.5): nested pages inside a project, written in Markdown.
// The composite parent key keeps a page and its parent in the same project.
// `version` increases on every save, so two people editing at once cannot overwrite each other.
model Doc {
  id             String   @id @default(cuid())
  projectId      String
  parentId       String?
  title          String
  content        String   @default("") @db.Text
  position       Int      @default(0)
  version        Int      @default(1)
  createdById    String?
  lastEditedById String?
  lastEditedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         Doc?     @relation("DocTree", fields: [parentId, projectId], references: [id, projectId], onDelete: Cascade)
  children       Doc[]    @relation("DocTree")
  createdBy      User?    @relation("DocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy   User?    @relation("DocEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@unique([id, projectId])
  @@index([projectId, parentId, position])
}

// Time tracking (PRD 6.8). A running timer is an entry without an end. The service keeps
// each person to one running timer. `projectId` is copied from the ticket for fast reports.
model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  ticketId  String
  startedAt DateTime
  endedAt   DateTime?
  note      String    @default("")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([userId, endedAt])
}
